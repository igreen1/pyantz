{
  "name": "pyantz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "dump-model-fields": "node scripts/dump_model_fields.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "@rjsf/core": "^6.1.2",
    "@rjsf/utils": "^6.1.2",
