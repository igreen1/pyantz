    "@types/json-schema": "^7.0.15",
    "@xyflow/react": "^12.10.0",
    "ajv": "^8.18.0",
    "axios": "^1.13.2",
    "bootstrap": "^5.3.8",
    "json-edit-react": "^1.29.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.1",
